# -----------------------------------------------------------------------------------
# TERRAFORM / TERRAGRUNT
# -----------------------------------------------------------------------------------

# Local state files
*.tfstate
*.tfstate.*

# Terragrunt cache directory
.terragrunt-cache/

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable override files
*.auto.tfvars
*.auto.tfvars.json
*.tfvars
*.tfvars.json

# Sensitive local environment overrides
terraform.tfvars
secrets.tfvars
*.secret.tfvars

# Locally generated files
.terraform/
.terraform.lock.hcl
terraform.rc

# -----------------------------------------------------------------------------------
# EDITOR / IDE FILES
# -----------------------------------------------------------------------------------

# VSCode
.vscode/
.history/
.settings/

# IntelliJ / JetBrains
.idea/
*.iml

# -----------------------------------------------------------------------------------
# OS FILES
# -----------------------------------------------------------------------------------

# macOS Finder files
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Linux temp files
*~

# Windows files
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------------
# LOGS & TEMPORARY FILES
# -----------------------------------------------------------------------------------

*.log
*.tmp
*.bak

# Python virtual envs (if used for tooling)
venv/
.env/
.env.*

# Node modules (if any scripting uses Node)
node_modules/

# Lock files generated by package managers
package-lock.json
yarn.lock

# -----------------------------------------------------------------------------------
# MISC
# -----------------------------------------------------------------------------------

# Ignore output directories
output/
build/
dist/